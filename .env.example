# 배포 도메인. metadataBase · canonical · sitemap · OG url 이 전부 이 값을 참조한다.
# 미설정 시 src/config/site.ts 의 기본값(https://step.ants-up.com)을 쓴다.
# Vercel 프리뷰 배포에서는 프리뷰 URL 로 덮어쓰면 된다.
NEXT_PUBLIC_SITE_URL=https://step.ants-up.com

# cash-bite-backend. 홈 좌측 프리뷰의 환율·지수 카드가 여기서 온다.
#
# NEXT_PUBLIC_ 을 붙이지 말 것. 이 레포는 공개 저장소이고 NEXT_PUBLIC_ 값은
# 브라우저 번들에 그대로 박힌다. 접두사가 없으면 서버에서만 읽힌다.
#
# 비워 두면 시장 카드만 조용히 사라지고 명언 카드가 그 자리를 채운다 —
# 백엔드가 없어도 홈은 멀쩡히 뜬다.
API_BASE_URL=http://localhost:3000

# 백엔드 InternalKeyGuard 용. 백엔드에 키가 설정돼 있을 때만 필요하다.
INTERNAL_API_KEY=
