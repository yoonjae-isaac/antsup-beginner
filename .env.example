# 배포 도메인. metadataBase · canonical · sitemap · OG url 이 전부 이 값을 참조한다.
# 미설정 시 src/config/site.ts 의 기본값(https://www.ants-up.com)을 쓴다.
# Vercel 프리뷰 배포에서는 프리뷰 URL 로 덮어쓰면 된다.
#
# www 를 빼지 말 것. apex 는 www 로 308 리다이렉트되므로, non-www 로 두면
# canonical·sitemap 이 전부 '곧바로 튕기는 주소'를 가리키게 된다.
NEXT_PUBLIC_SITE_URL=https://www.ants-up.com

# cash-bite-backend. 홈 좌측 프리뷰의 환율·지수 카드가 여기서 온다.
#
# NEXT_PUBLIC_ 을 붙이지 말 것. 이 레포는 공개 저장소이고 NEXT_PUBLIC_ 값은
# 브라우저 번들에 그대로 박힌다. 접두사가 없으면 서버에서만 읽힌다.
#
# 비워 두면 시장 카드만 조용히 사라지고 명언 카드가 그 자리를 채운다 —
# 백엔드가 없어도 홈은 멀쩡히 뜬다.
API_BASE_URL=http://localhost:3000

# 백엔드 InternalKeyGuard 용. 백엔드에 키가 설정돼 있을 때만 필요하다.
INTERNAL_API_KEY=

# Google Tag Manager 컨테이너 ID (GTM-XXXXXXX). GA4 는 이 컨테이너 안에서 설정한다.
#
# 로컬·프리뷰에서는 비워 둘 것. 값이 있으면 그 환경의 트래픽이 운영 속성에 섞인다.
# 비면 GTM 스니펫과 noscript iframe 이 아예 렌더되지 않는다(동의 배너는 그대로 뜬다).
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_KEY=

# Google Search Console 소유확인 메타 태그 값 (선택).
#
# ants-up.com 은 도메인 속성(DNS TXT)으로 등록돼 있어 지금은 필요 없다.
# 서브도메인을 URL 접두어 속성으로 따로 등록할 때만 채운다.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense 퍼블리셔 ID (ca-pub-XXXXXXXXXXXXXXXX) — 승인 후 설정.
# 승인 전에 넣으면 빈 광고 스크립트만 실린다.
NEXT_PUBLIC_ADSENSE_CLIENT=
